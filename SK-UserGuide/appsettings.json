{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Qdrant": {
    "Host": "http://localhost:6333",
    "Port": 6333,
    "DefaultCollection": "default"
  },
  "Llm": {
    "Provider": "OpenAI", // model-agnostic. If you want to switch to Azure Open AI provider, type Azure Open AI.
    "EmbeddingDimensions": 1536,
    "MaxTokens": 1500,
    "Temperature": 0.3,
    "TopP": 0.9
  },
  "OpenAI": {
    "ApiKey": "YOUR_API_KEY",
    "ChatModel": "YOUR_CHAT_MODEL",
    "EmbeddingModel": "YOUR_EMBEDDING_MODEL"
  },
  "AzureOpenAI": {
    "Endpoint": "YOUR_ENDPOINT",
    "ApiKey": "YOUR_API_KEY",
    "ChatDeploymentName": "YOUR_CHAT_DEPLOYMENT_NAME",
    "EmbeddingDeploymentName": "YOUR_EMBEDDİNG_DEPLOYMENT_NAME",
    "ApiVersion": "YOUR_API_VERSION"
  },
  "Rag": {
    "ResponseMode": "Hybrid",
    "ContextTokenBudget": 3000,
    "CompressorTokenBudget": 1500,
    "SummaryMaxSentences": 12,
    "SummaryTargetTokens": 1000,
    "MaxSentencesPerChunk": 8
  }
}