{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Qdrant": {
    "Host": "http://localhost:6333",
    "Port": 6333,
    "DefaultCollection": "default"
  },
  "Llm": {
    "Provider": "OpenAI",
    "ChatModel": "gpt-4o",
    "EmbeddingModel": "nomic-embed-text",
    "EmbeddingDimensions": 768,
    "MaxTokens": 1500,
    "Temperature": 0.3,
    "TopP": 0.9
  },
  "OpenAI": {
  },
  "Ollama": {
    "Endpoint": "http://localhost:11434"
  },
  "Rag": {
    "ResponseMode": "Hybrid",
    "ContextTokenBudget": 3000,
    "CompressorTokenBudget": 1500,
    "SummaryMaxSentences": 12,
    "SummaryTargetTokens": 1000,
    "MaxSentencesPerChunk": 8
  }
}