@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="hero-section bg-primary text-white py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold mb-4">SK UserGuide</h1>
                <p class="lead mb-4">
                    Şirket içi kullanıcı rehberi için yapay zeka destekli asistan. 
                    Dosya yükleme, sorularınızı yanıtlama ve daha fazlası için buradayız.
                </p>
                <div class="d-flex gap-3">
                    <a href="/Chat/Index" class="btn btn-light btn-lg">
                        <i class="bi bi-chat-dots"></i> AI Chatbot
                    </a>
                    <a href="/Admin/Index" class="btn btn-outline-light btn-lg">
                        <i class="bi bi-upload"></i> Admin Panel
                    </a>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <img src="~/images/ai-assistant.svg" alt="AI Assistant" class="img-fluid" style="max-height: 400px;" onerror="this.style.display='none'">
                <div class="mt-3">
                    <i class="bi bi-robot display-1 text-white-50"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-chat-dots text-primary display-4 mb-3"></i>
                    <h5 class="card-title">AI Chatbot</h5>
                    <p class="card-text">Şirket içi sorularınızı yapay zeka ile yanıtlayın. Dosya yükleme ve arama özelliği ile.</p>
                    <a href="/Chat/Index" class="btn btn-primary">Başla</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-upload text-success display-4 mb-3"></i>
                    <h5 class="card-title">Doküman Yükleme</h5>
                    <p class="card-text">PDF ve TXT formatında dosyalarınızı yükleyin. Sistem otomatik olarak işler ve arama için hazırlar.</p>
                    <a href="/Admin/Index" class="btn btn-success">Yükle</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-shield-check text-info display-4 mb-3"></i>
                    <h5 class="card-title">Güvenli & Özel</h5>
                    <p class="card-text">Tüm verileriniz yerel olarak işlenir. Şirket içi kullanım için optimize edilmiştir.</p>
                    <a href="/Home/Privacy" class="btn btn-info">Gizlilik</a>
                </div>
            </div>
        </div>
    </div>
</div>
