@{
    ViewData["Title"] = "AI Chatbot";
    var tenants = ViewBag.Tenants as List<string> ?? new List<string>();
    var selectedTenantId = ViewBag.SelectedTenantId as string ?? string.Empty;
    var tenantLoadError = ViewBag.TenantLoadError as string;
    var hasTenant = !string.IsNullOrWhiteSpace(selectedTenantId);
}

<style>
    /* Ana Container */
    .chat-container {
        max-width: 900px;
        margin: 0 auto;
        height: calc(100vh - 200px);
        min-height: 500px;
        display: flex;
        flex-direction: column;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        overflow: hidden;
    }

    /* Header */
    .chat-header {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        padding: 20px 25px;
        display: flex;
        align-items: center;
        gap: 15px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    }

    .chat-header .avatar {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, #00f260, #0575e6);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

    .chat-header .info h4 {
        color: white;
        margin: 0;
        font-weight: 600;
    }

    .chat-header .info span {
        color: rgba(255, 255, 255, 0.7);
        font-size: 13px;
    }

    .tenant-bar {
        background: #ffffff;
        border-bottom: 1px solid #e9ecef;
        padding: 14px 25px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .tenant-bar label {
        font-size: 13px;
        font-weight: 600;
        color: #495057;
        margin: 0;
        white-space: nowrap;
    }

    .tenant-bar select {
        max-width: 320px;
    }

    .tenant-warning {
        color: #b02a37;
        font-size: 13px;
    }

    .status-dot {
        width: 10px;
        height: 10px;
        background: #00ff88;
        border-radius: 50%;
        display: inline-block;
        margin-right: 5px;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {

        0%,
        100% {
            opacity: 1;
        }

        50% {
            opacity: 0.5;
        }
    }

    /* Mesaj Alan? */
    .chat-messages {
        flex: 1;
        padding: 25px;
        overflow-y: auto;
        background: #f8f9fa;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .message {
        max-width: 75%;
        padding: 15px 20px;
        border-radius: 20px;
        position: relative;
        animation: fadeInUp 0.3s ease;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .message.user {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        align-self: flex-end;
        border-bottom-right-radius: 5px;
    }

    .message.bot {
        background: white;
        color: #333;
        align-self: flex-start;
        border-bottom-left-radius: 5px;
        box-shadow: 0 3px 15px rgba(0, 0, 0, 0.1);
    }

    .message .time {
        font-size: 11px;
        opacity: 0.7;
        margin-top: 8px;
        display: block;
    }

    .message.user .time {
        text-align: right;
    }

    @@keyframes typing {

        0%,
        60%,
        100% {
            transform: translateY(0);
        }

        30% {
            transform: translateY(-10px);
        }
    }

    /* Typing dots inside message bubble */
    .typing-dots {
        display: inline-flex;
        gap: 4px;
        padding: 5px 0;
    }

    .typing-dots span {
        width: 8px;
        height: 8px;
        background: #667eea;
        border-radius: 50%;
        animation: typing 1.4s infinite ease-in-out;
    }

    .typing-dots span:nth-child(2) {
        animation-delay: 0.2s;
    }

    .typing-dots span:nth-child(3) {
        animation-delay: 0.4s;
    }

    /* Input Alan? */
    .chat-input {
        padding: 20px 25px;
        background: white;
        border-top: 1px solid #eee;
        display: flex;
        gap: 15px;
        align-items: center;
    }

    .chat-input input {
        flex: 1;
        padding: 15px 20px;
        border: 2px solid #e9ecef;
        border-radius: 30px;
        font-size: 15px;
        transition: all 0.3s ease;
        outline: none;
    }

    .chat-input input:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
    }

    .chat-input input::placeholder {
        color: #adb5bd;
    }

    .btn-send {
        width: 55px;
        height: 55px;
        border: none;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 50%;
        cursor: pointer;
        font-size: 20px;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 5px 20px rgba(102, 126, 234, 0.4);
    }

    .btn-send:hover {
        transform: scale(1.1);
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.5);
    }

    .btn-send:active {
        transform: scale(0.95);
    }

    .btn-send:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
    }

    /* Scrollbar */
    .chat-messages::-webkit-scrollbar {
        width: 6px;
    }

    .chat-messages::-webkit-scrollbar-track {
        background: transparent;
    }

    .chat-messages::-webkit-scrollbar-thumb {
        background: #ccc;
        border-radius: 3px;
    }

    .chat-messages::-webkit-scrollbar-thumb:hover {
        background: #aaa;
    }

    /* Welcome Message */
    .welcome-card {
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
        border: 1px dashed #667eea;
        border-radius: 15px;
        padding: 25px;
        text-align: center;
        margin-bottom: 10px;
    }

    .welcome-card h5 {
        color: #667eea;
        margin-bottom: 10px;
    }

    .welcome-card p {
        color: #666;
        margin: 0;
        font-size: 14px;
    }

    /* Quick Actions */
    .quick-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: center;
        margin-top: 15px;
    }

    .quick-btn {
        padding: 8px 16px;
        background: white;
        border: 1px solid #667eea;
        color: #667eea;
        border-radius: 20px;
        cursor: pointer;
        font-size: 13px;
        transition: all 0.3s ease;
    }

    .quick-btn:hover {
        background: #667eea;
        color: white;
    }

    /* Error Message */
    .message.error {
        background: #fff5f5;
        border: 1px solid #fed7d7;
        color: #c53030;
    }
</style>

<div class="chat-container">
    <!-- Header -->
    <div class="chat-header">
        <div class="avatar">🤖</div>
        <div class="info">
            <h4>SK UserGuide Assistant</h4>
            <span><span class="status-dot"></span>Online - Ready to help</span>
        </div>
    </div>

    <div class="tenant-bar">
        <label for="tenantSelect">Tenant</label>
        <select id="tenantSelect" class="form-select form-select-sm" onchange="changeTenant()" @(tenants.Count == 0 ? "disabled" : "")>
            @if (tenants.Count == 0)
            {
                    <option value="">No tenant collections yet</option>
            }
            else
            {
                @foreach (var tenant in tenants)
                {
                            <option value="@tenant" selected="@(tenant == selectedTenantId)">@tenant</option>
                }
            }
        </select>
        @if (!string.IsNullOrWhiteSpace(tenantLoadError))
        {
                <span class="tenant-warning">@tenantLoadError</span>
        }
        else if (!hasTenant)
        {
                <span class="tenant-warning">Create a tenant and upload documents in Admin before chatting.</span>
        }
    </div>

    <!-- Messages -->
    <div class="chat-messages" id="chatMessages">
        <div class="welcome-card">
            <h5>👋 Welcome!</h5>
            <p>I'm your Supply Chain & Planning assistant. Ask me about demand forecasting, inventory management,
                production schedules, and more.</p>
            <div class="quick-actions">
                <button class="quick-btn"
                    onclick="askQuickQuestion('Analyze the demand forecast for the next quarter based on historical sales data.')">📊
                    Demand Forecast</button>
                <button class="quick-btn"
                    onclick="askQuickQuestion('Show me the current inventory levels for SKU-1024 across all warehouses.')">📦
                    Inventory Levels</button>
                <button class="quick-btn"
                    onclick="askQuickQuestion('Identify potential supply chain bottlenecks in the production schedule for next week.')">⚠️
                    Bottlenecks</button>
            </div>
        </div>

        <div class="message bot">
            Hello! How can I help you today?
            <span class="time">now</span>
        </div>
    </div>

    <!-- Input -->
    <div class="chat-input">
        <input type="text" id="questionInput" placeholder="Type your question here..." autocomplete="off"
            onkeypress="handleKeyPress(event)" @(hasTenant ? "" : "disabled")>
        <button class="btn-send" id="sendBtn" onclick="sendQuestion()" @(hasTenant ? "" : "disabled")>
            <span>?</span>
        </button>
    </div>
</div>

@section Scripts {
    <script>
        const chatMessages = document.getElementById('chatMessages');
        const questionInput = document.getElementById('questionInput');
        const sendBtn = document.getElementById('sendBtn');
        const tenantSelect = document.getElementById('tenantSelect');
        const selectedTenantId = '@selectedTenantId';

        // Enter tu?u ile gönder
        function handleKeyPress(event) {
            if (event.key === 'Enter' && !event.shiftKey) {
                event.preventDefault();
                sendQuestion();
            }
        }

        // H?zl? soru sor
        function askQuickQuestion(question) {
            if (!selectedTenantId) {
                addMessage('Please create or select a tenant collection before asking a question.', false, true);
                return;
            }
            questionInput.value = question;
            sendQuestion();
        }

        function changeTenant() {
            const tenantId = tenantSelect.value;
            if (!tenantId) return;
            window.location.href = '@Url.Action("Index", "Chat")' + '?tenantId=' + encodeURIComponent(tenantId);
        }

        // Format time
        function formatTime() {
            return new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
        }

        // Mesaj ekle
        function addMessage(text, isUser, isError = false) {
            const messageDiv = document.createElement('div');
            messageDiv.className = `message ${isUser ? 'user' : (isError ? 'bot error' : 'bot')}`;
            const textNode = document.createElement('span');
            textNode.textContent = text;
            const timeNode = document.createElement('span');
            timeNode.className = 'time';
            timeNode.textContent = formatTime();
            messageDiv.appendChild(textNode);
            messageDiv.appendChild(timeNode);
            chatMessages.appendChild(messageDiv);
            scrollToBottom();
        }

        // En alta scroll
        function scrollToBottom() {
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        // Soru gönder - Streaming ile
        function sendQuestion() {
            const question = questionInput.value.trim();
            const tenantId = selectedTenantId;

            if (!question) {
                questionInput.focus();
                return;
            }

            if (!tenantId) {
                addMessage('Please create or select a tenant collection before asking a question.', false, true);
                return;
            }

            // UI'ı devre dışı bırak
            questionInput.disabled = true;
            sendBtn.disabled = true;

            // Kullanıcı mesajını ekle
            addMessage(question, true);
            questionInput.value = '';

            // Typing indicator ile bot mesajı oluştur
            const botMessage = document.createElement('div');
            botMessage.className = 'message bot';
            botMessage.innerHTML = `
                                    <div class="typing-dots">
                                        <span></span><span></span><span></span>
                                    </div>
                                    <span class="streaming-text" style="display:none;"></span>
                                    <span class="time">${formatTime()}</span>
                                `;
            chatMessages.appendChild(botMessage);
            scrollToBottom();

            const typingDots = botMessage.querySelector('.typing-dots');
            const streamingText = botMessage.querySelector('.streaming-text');
            let fullText = '';
            let firstChunkReceived = false;

            // EventSource ile streaming bağlantısı
            const streamUrl = '@Url.Action("AskStreaming", "Chat")'
                + '?question=' + encodeURIComponent(question)
                + '&tenantId=' + encodeURIComponent(tenantId);
            const eventSource = new EventSource(streamUrl);

            eventSource.onmessage = function (event) {
                const data = event.data;

                // Stream sonu kontrolü
                if (data === '[DONE]') {
                    eventSource.close();
                    // Markdown'ı render et (eğer varsa)
                    streamingText.innerHTML = formatMarkdown(fullText);
                    scrollToBottom();

                    // UI'ı tekrar aktif et
                    questionInput.disabled = false;
                    sendBtn.disabled = false;
                    questionInput.focus();
                    return;
                }

                // İlk chunk geldiğinde typing indicator'ı kaldır
                if (!firstChunkReceived) {
                    typingDots.style.display = 'none';
                    streamingText.style.display = 'inline';
                    firstChunkReceived = true;
                }

                // Newline'ları geri çevir
                const text = data.replace(/\\n/g, '\n');
                fullText += text;

                // Anlık gösterim için basit escape
                streamingText.textContent = fullText;
                scrollToBottom();
            };

            eventSource.onerror = function (error) {
                eventSource.close();

                if (fullText === '') {
                    streamingText.textContent = 'An error occurred while connecting to the server.';
                    botMessage.classList.add('error');
                }

                // UI'ı tekrar aktif et
                questionInput.disabled = false;
                sendBtn.disabled = false;
                questionInput.focus();
            };
        }

        // Basit Markdown formatlama
        function formatMarkdown(text) {
            return escapeHtml(text)
                .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')  // Bold
                .replace(/\n/g, '<br>')  // Newlines
                .replace(/---/g, '<hr>');  // Horizontal rule
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // Sayfa yüklendi?inde input'a focus
        document.addEventListener('DOMContentLoaded', () => {
            if (selectedTenantId) {
                questionInput.focus();
            }
        });
    </script>
}
