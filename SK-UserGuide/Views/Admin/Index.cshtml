@{
    ViewData["Title"] = "Admin Panel";
    var documents = ViewBag.Documents as List<SK_UserGuide.Services.Ingestion.DocumentInfo>
    ?? new List<SK_UserGuide.Services.Ingestion.DocumentInfo>();
    var tenants = ViewBag.Tenants as List<string> ?? new List<string>();
    var selectedTenantId = ViewBag.TenantId as string ?? string.Empty;
    var hasTenant = !string.IsNullOrWhiteSpace(selectedTenantId);
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <!-- Tenant Card -->
            <div class="card shadow mb-4">
                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-diagram-3 me-2"></i>Tenant / Collection
                    </h4>
                </div>
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-6">
                            <label for="tenantSelect" class="form-label">Active tenant collection</label>
                            <select id="tenantSelect" class="form-select" onchange="changeTenant()" @(tenants.Count == 0 ? "disabled" : "")>
                                @if (tenants.Count == 0)
                                {
                                        <option value="">No tenant collections yet</option>
                                }
                                else
                                {
                                    @foreach (var tenant in tenants)
                                    {
                                                <option value="@tenant" selected="@(tenant == selectedTenantId)">@tenant</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="newTenantInput" class="form-label">Create tenant</label>
                            <input type="text" id="newTenantInput" class="form-control" placeholder="company-a" autocomplete="off">
                        </div>
                        <div class="col-md-2 d-grid">
                            <button type="button" class="btn btn-primary" onclick="createTenant()" id="createTenantBtn">
                                Create
                            </button>
                        </div>
                    </div>
                    <div class="form-text mt-2">
                        Uploads and deletes apply only to the selected tenant collection.
                    </div>
                </div>
            </div>

            <!-- Upload Card -->
            <div class="card shadow mb-4">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-upload me-2"></i>Document Upload
                    </h4>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-4">
                        Upload your files in PDF, DOCX or TXT format. The system automatically extracts text,
                        converts to embeddings, and prepares for search.
                    </p>

                    <form asp-action="Upload" method="post" enctype="multipart/form-data" class="drop-zone"
                        id="uploadForm">
                        <input type="hidden" id="uploadTenantId" name="tenantId" value="@selectedTenantId">
                        <div class="text-center mb-4">
                            <i class="bi bi-cloud-upload display-4 text-primary mb-3"></i>
                            <h5>Drag and Drop Files Here</h5>
                            <p class="text-muted">or</p>
                            <label for="fileInput" class="btn btn-primary btn-lg">
                                <i class="bi bi-folder-open me-2"></i>Select File
                            </label>
                            <input type="file" id="fileInput" name="file" accept=".txt,.pdf,.docx" class="d-none" required>
                        </div>

                        <div class="selected-file mb-3" id="selectedFile" style="display: none;">
                            <div class="alert alert-info">
                                <i class="bi bi-file-earmark me-2"></i>
                                <span id="fileName"></span>
                                <button type="button" class="btn-close float-end" onclick="clearFile()"></button>
                            </div>
                        </div>

                        <div class="text-center">
                            <button type="submit" class="btn btn-success btn-lg" id="uploadBtn" @(hasTenant ? "" : "disabled")>
                                <i class="bi bi-upload me-2"></i>Yukle ve Isle
                            </button>
                            @if (!hasTenant)
                            {
                                    <div class="text-muted small mt-2">Create or select a tenant before uploading.</div>
                            }
                        </div>
                    </form>

                    @if (TempData["Error"] != null)
                    {
                            <div class="alert alert-danger mt-4">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                <strong>Error:</strong> @TempData["Error"]
                            </div>
                    }

                    @if (TempData["Message"] != null)
                    {
                            <div
                                class="alert @(TempData["Success"]?.ToString() == "true" ? "alert-success" : "alert-info") mt-4">
                                <i class="bi bi-check-circle me-2"></i>@TempData["Message"]
                            @if (TempData["ChunkCount"] != null)
                            {
                                        <br>
                                        <small class="text-muted">
                                            Chunks: @TempData["ChunkCount"] |
                                            Time: @TempData["ProcessingTime"] ms
                                        </small>
                            }
                            </div>
                    }
                </div>
            </div>

            <!-- Document List Card -->
            <div class="card shadow">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">
                        <i class="bi bi-folder2-open me-2"></i>Uploaded Documents
                        @if (hasTenant)
                        {
                                <small class="fw-normal">(@selectedTenantId)</small>
                        }
                    </h4>
                    <button class="btn btn-light btn-sm" onclick="refreshDocuments()">
                        <i class="bi bi-arrow-clockwise"></i> Refresh
                    </button>
                </div>
                <div class="card-body">
                    @if (!hasTenant)
                    {
                            <div class="text-center text-muted py-4">
                                <i class="bi bi-inboxes display-4"></i>
                                <p class="mt-3">Create or select a tenant collection to view documents.</p>
                            </div>
                    }
                    else if (documents.Count == 0)
                    {
                            <div class="text-center text-muted py-4">
                                <i class="bi bi-inbox display-4"></i>
                                <p class="mt-3">No documents uploaded yet.</p>
                            </div>
                    }
                    else
                    {
                            <div class="table-responsive">
                                <table class="table table-hover" id="documentsTable">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Document Name</th>
                                            <th class="text-center">Chunk Count</th>
                                            <th class="text-center">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var doc in documents)
                                    {
                                                <tr data-doc-id="@doc.DocId">
                                                    <td>
                                                        <i class="bi bi-file-earmark-text text-primary me-2"></i>
                                                @doc.DocName
                                                        <br>
                                                        <small class="text-muted">ID: @doc.DocId</small>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge bg-secondary">@doc.ChunkCount chunks</span>
                                                    </td>
                                                    <td class="text-center">
                                                        <button class="btn btn-danger btn-sm"
                                                            data-doc-id="@doc.DocId"
                                                            data-doc-name="@doc.DocName"
                                                            onclick="deleteDocumentFromButton(this)">
                                                            <i class="bi bi-trash"></i> Delete
                                                        </button>
                                                    </td>
                                                </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                            <div class="text-muted small mt-2">
                                Total: @documents.Count documents, @documents.Sum(d => d.ChunkCount) chunks
                            </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2"></i>Delete Document</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong id="deleteDocName"></strong>?</p>
                <p class="text-muted small">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn" onclick="confirmDelete()">
                    <i class="bi bi-trash me-1"></i>Delete
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
        <script>
            const fileInput = document.getElementById('fileInput');
            const selectedFile = document.getElementById('selectedFile');
            const fileName = document.getElementById('fileName');
            const uploadBtn = document.getElementById('uploadBtn');
            const dropZone = document.querySelector('.drop-zone');
            const tenantSelect = document.getElementById('tenantSelect');
            const uploadTenantId = document.getElementById('uploadTenantId');
            const selectedTenantId = '@selectedTenantId';

            let pendingDeleteDocId = null;

            fileInput.addEventListener('change', function (e) {
                const file = e.target.files[0];
                if (file) {
                    showSelectedFile(file);
                }
            });

            dropZone.addEventListener('dragover', function (e) {
                e.preventDefault();
                dropZone.classList.add('drag-over');
            });

            dropZone.addEventListener('dragleave', function (e) {
                e.preventDefault();
                dropZone.classList.remove('drag-over');
            });

            dropZone.addEventListener('drop', function (e) {
                e.preventDefault();
                dropZone.classList.remove('drag-over');

                const files = e.dataTransfer.files;
                if (files.length > 0) {
                    const file = files[0];
                    const ext = file.name.toLowerCase();
                    if (ext.endsWith('.txt') || ext.endsWith('.pdf') || ext.endsWith('.docx')) {
                        // DataTransfer API kullanarak dosyayı input'a ata
                        const dataTransfer = new DataTransfer();
                        dataTransfer.items.add(file);
                        fileInput.files = dataTransfer.files;
                        showSelectedFile(file);
                    } else {
                        alert('Only .txt, .pdf and .docx files are supported.');
                    }
                }
            });

            function showSelectedFile(file) {
                fileName.textContent = file.name;
                selectedFile.style.display = 'block';
                uploadBtn.disabled = !selectedTenantId;
            }

            function clearFile() {
                fileInput.value = '';
                selectedFile.style.display = 'none';
                uploadBtn.disabled = true;
            }

            document.getElementById('uploadForm').addEventListener('submit', function (e) {
                if (!selectedTenantId) {
                    e.preventDefault();
                    alert('Please create or select a tenant collection first.');
                    return false;
                }

                uploadTenantId.value = selectedTenantId;

                // Dosya kontrolü
                if (!fileInput.files || fileInput.files.length === 0) {
                    e.preventDefault();
                    alert('Please select a file.');
                    return false;
                }

                uploadBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Uploading...';
                uploadBtn.disabled = true;
            });

            function changeTenant() {
                const tenantId = tenantSelect.value;
                if (!tenantId) return;
                window.location.href = '@Url.Action("Index", "Admin")' + '?tenantId=' + encodeURIComponent(tenantId);
            }

            async function createTenant() {
                const input = document.getElementById('newTenantInput');
                const btn = document.getElementById('createTenantBtn');
                const tenantId = input.value.trim();

                if (!tenantId) {
                    input.focus();
                    return;
                }

                btn.disabled = true;
                btn.textContent = 'Creating...';

                try {
                    const response = await fetch('@Url.Action("CreateTenant", "Admin")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: `tenantId=${encodeURIComponent(tenantId)}`
                    });

                    const result = await response.json();
                    if (result.success) {
                        window.location.href = '@Url.Action("Index", "Admin")' + '?tenantId=' + encodeURIComponent(result.tenantId);
                    } else {
                        showToast(result.message || 'Tenant could not be created.', 'danger');
                    }
                } catch {
                    showToast('Tenant could not be created.', 'danger');
                } finally {
                    btn.disabled = false;
                    btn.textContent = 'Create';
                }
            }

            function deleteDocumentFromButton(button) {
                deleteDocument(button.dataset.docId, button.dataset.docName);
            }

            function deleteDocument(docId, docName) {
                pendingDeleteDocId = docId;
                document.getElementById('deleteDocName').textContent = docName;
                new bootstrap.Modal(document.getElementById('deleteModal')).show();
            }

            async function confirmDelete() {
                if (!pendingDeleteDocId) return;
                if (!selectedTenantId) {
                    showToast('TenantId is required.', 'danger');
                    return;
                }

                const btn = document.getElementById('confirmDeleteBtn');
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Deleting...';
                btn.disabled = true;

                try {
                    const response = await fetch('@Url.Action("DeleteDocument", "Admin")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: `docId=${encodeURIComponent(pendingDeleteDocId)}&tenantId=${encodeURIComponent(selectedTenantId)}`
                    });

                    const result = await response.json();

                    if (result.success) {
                        const row = document.querySelector(`tr[data-doc-id="${pendingDeleteDocId}"]`);
                        if (row) {
                            row.remove();
                        }
                        bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
                        showToast('Document deleted successfully.', 'success');
                    } else {
                        showToast(result.message || 'Delete error.', 'danger');
                    }
                } catch (error) {
                    showToast('An error occurred: ' + error.message, 'danger');
                } finally {
                    btn.innerHTML = '<i class="bi bi-trash me-1"></i>Delete';
                    btn.disabled = false;
                    pendingDeleteDocId = null;
                }
            }

            function refreshDocuments() {
                location.reload();
            }

            function showToast(message, type) {
                const toast = document.createElement('div');
                toast.className = `alert alert-${type} position-fixed bottom-0 end-0 m-3`;
                toast.style.zIndex = '9999';
                toast.textContent = message;
                document.body.appendChild(toast);
                setTimeout(() => toast.remove(), 3000);
            }

            document.addEventListener('DOMContentLoaded', function () {
                if (fileInput.files.length > 0) {
                    showSelectedFile(fileInput.files[0]);
                }
            });
        </script>
}

<style>
    .drop-zone {
        border: 2px dashed #dee2e6;
        border-radius: 10px;
        padding: 40px 20px;
        transition: all 0.3s ease;
        background-color: #f8f9fa;
    }

    .drop-zone.drag-over {
        border-color: #0d6efd;
        background-color: #e7f3ff;
    }

    .drop-zone:hover {
        border-color: #0d6efd;
        background-color: #f0f8ff;
    }

    .table tbody tr {
        transition: background-color 0.2s;
    }

    .table tbody tr:hover {
        background-color: #f8f9fa;
    }
</style>
